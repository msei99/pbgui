# Add the PB8 multi-venue BTC source fix to the currently pinned worker image.
# Existing rentals retain their original immutable image and job intent.
FROM ghcr.io/msei99/pbgui-pb8-worker@sha256:a1a458b296653e438d2dac5a1cbfd4fa990045ce28cd4a2f70684fc2a404a0bf

RUN grep -qx '903ed11153ce82d1b6760604eaa3a553309a752a' /opt/pb8-revision
COPY pb8_multi_venue_btc.patch /tmp/pb8_multi_venue_btc.patch
RUN cd /opt/passivbot \
    && git diff --quiet -- src/hlcv_preparation.py \
    && git apply --check /tmp/pb8_multi_venue_btc.patch \
    && git apply /tmp/pb8_multi_venue_btc.patch \
    && printf '%s  %s\n' \
       '1697253d6eb86893df1de967789da40cb6bf6e02bb47909952a56022e915b987' \
       'src/hlcv_preparation.py' | sha256sum -c - \
    && PYTHONPATH=/opt/passivbot/src python -c \
       'import ast, pathlib; ast.parse(pathlib.Path("src/hlcv_preparation.py").read_text()); from hlcv_preparation import _load_combined_btc_prices' \
    && rm /tmp/pb8_multi_venue_btc.patch

LABEL org.opencontainers.image.title="PBGui PB8 Multi-Venue BTC Worker"
