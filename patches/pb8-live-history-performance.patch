+def test_legacy_clock_defaults_and_detached_read_results(manager):
+    """A warm range view freezes neither missing timestamps nor mutable results."""
+    install(manager, [[0, ONE_MIN_MS], {"start_ts": 0, "end_ts": ONE_MIN_MS}])
